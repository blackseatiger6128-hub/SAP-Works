<?xml version="1.0" encoding="utf-8"?><mc:messageClass adtcore:responsible="MKESKIN" adtcore:masterLanguage="TR" adtcore:masterSystem="GED" adtcore:name="ZPPAUTO" adtcore:type="MSAG/N" adtcore:changedAt="2026-08-25T14:23:59Z" adtcore:version="active" adtcore:createdAt="2026-07-16T21:00:00Z" adtcore:changedBy="MKESKIN" adtcore:createdBy="MKESKIN" adtcore:description="ZPPAUTO mesajları" adtcore:language="TR" xmlns:mc="http://www.sap.com/adt/MessageClass" xmlns:adtcore="http://www.sap.com/adt/core"><adtcore:packageRef adtcore:uri="/sap/bc/adt/packages/%24zmk_rap_pp_automative_main" adtcore:type="DEVC/K" adtcore:name="$ZMK_RAP_PP_AUTOMATIVE_MAIN"/><mc:messages mc:msgno="012" mc:msgtext="Üretime başlamayacak olursa üretim plan statüsü &amp; değil IN_REVIEW olmalı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO012" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/012" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="013" mc:msgtext="Üretime başlarken üretim plan statüsü &amp; değil, APPROVED olmalı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO013" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/013" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="015" mc:msgtext="Plan statüsü geçerli değil. Eski: &amp; Yeni: &amp;" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO015" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/015" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="016" mc:msgtext="Uygun &amp; bulunamadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO016" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/016" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="017" mc:msgtext="Üretim onayı için plan statüsü NEW yada REJECTED değil!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO017" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/017" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="018" mc:msgtext="Planlanan başlangıç, bitiş tarihinden büyük olamaz!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO018" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/018" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="019" mc:msgtext="&amp; eski üretim plan durumu, yeni üretim plan durumundan &amp; farklı olmalı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO019" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/019" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="020" mc:msgtext="Üretim planına göre üretim siparişleri bulunamadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO020" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/020" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="022" mc:msgtext="Üretim siparişlerinde miktarlar 0'dan büyük olmalıdır!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO022" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/022" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="031" mc:msgtext="Planlı siparişlerin üretim siparişine dönüşürken durumu OPEN olmalıdır." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO031" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/031" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="032" mc:msgtext="Tahmin parametresine göre açık malzemeleri talep bilgileri bulunamadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO032" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/032" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="033" mc:msgtext="İhtiyaç taleplerine göre önerilen tarihlerde &amp; adet planlı sipariş oluştu" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO033" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/033" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="034" mc:msgtext="&amp; malzemeye ait üretim siparişler için planlanan dönem yok." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO034" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/034" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="035" mc:msgtext="&amp; malzemeye ait üretim siparişi için ürün ağacı patlatılamadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO035" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/035" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="036" mc:msgtext="İhtiyaç taleplerine göre önerilen tarihlerde planlı sipariş oluşmadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO036" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/036" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="037" mc:msgtext="İhtiyaç taleplerine göre talep durumu &quot;PROCESSED&quot; olmadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO037" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/037" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="038" mc:msgtext="&amp; malzemeye ait üretim siparişler oluşurken hata meydana geldi." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO038" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/038" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="039" mc:msgtext="&amp; malzemeye ait üretim siparişinde evre oluşurken hata meydana geldi." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO039" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/039" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="040" mc:msgtext="İhtiyaç planı için talep miktarı 0'dan büyük olmalıdır!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO040" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/040" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="041" mc:msgtext="&amp; talep tahmini şu anda işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-24" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO041" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/041" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="042" mc:msgtext="Planlı üretim için miktar 0'dan büyük olmalıdır!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-08-25" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO042" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/042" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="043" mc:msgtext="&amp; malzeme kodu şu anda işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-24" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO043" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/043" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="044" mc:msgtext="&amp; ürün ağacı şu an işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-24" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO044" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/044" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="045" mc:msgtext="&amp; lot master verisi işleniyor" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-27" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO045" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/045" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="046" mc:msgtext="&amp; malzeme kodu stok verisi işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-27" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO046" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/046" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="047" mc:msgtext="&amp; işyeri ID'si şu anda işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-08-06" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO047" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/047" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="048" mc:msgtext="&amp; makine ID'si şu anda işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-08-06" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO048" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/048" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="049" mc:msgtext="&amp; shift ID şu anda işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-08-06" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO049" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/049" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="050" mc:msgtext="&amp; malzeme kodu için &amp; rezerve edilmiş miktar serbest miktar &amp; dan büyük" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO050" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/050" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="051" mc:msgtext="Ürün ağacına ait bileşenlerinde aktif kalem bulunamadı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO051" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/051" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="052" mc:msgtext="&amp; nolu plan şu an işleniyor." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-08-25" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO052" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/052" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="063" mc:msgtext="Malzemeye ait ürün ağacı kalemlerinde herhangi bir aktif bileşen yok" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-23" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO063" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/063" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="071" mc:selfexplainatory="false" mc:documented="true" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO071" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/ZPPAUTO/messages/071/longtext?language=T&amp;msgv1=%3c%28%3e%26%3c%29%3eV1%3c%28%3e%26%3c%29%3e&amp;msgv2=%3c%28%3e%26%3c%29%3eV2%3c%28%3e%26%3c%29%3e&amp;msgv3=%3c%28%3e%26%3c%29%3eV3%3c%28%3e%26%3c%29%3e&amp;msgv4=%3c%28%3e%26%3c%29%3eV4%3c%28%3e%26%3c%29%3e" rel="http://www.sap.com/adt/relations/messageclasses/messages/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/071" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="081" mc:msgtext="Üretim planına göre henüz bileşenler tüketilmedi veya lot üretilemedi!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO081" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/081" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="084" mc:msgtext="Üretim siparişleri oluşturuldu. (&amp; tane)" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO084" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/084" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="085" mc:msgtext="&amp; malzemeye ait üretimiş olacak siparişler &amp; planlanan dönem bulundu." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO085" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/085" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="086" mc:msgtext="Üretim Planı tamamlanırken, statüsü IN_PRODUCTION olmalı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO086" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/086" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="087" mc:msgtext="Üretim planı başarılı bir şekilde onaylandı." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO087" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/087" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="088" mc:msgtext="Üretim Plan Statüsü, IN_PRODUCTION, COMPLETED ya da CANCELLED olmamalı!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO088" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/088" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="089" mc:msgtext="Üretim planı başarılı bir şekilde iptal edildi." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO089" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/089" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="092" mc:msgtext="Üretimde &amp; malzeme için lot oluşurken stok defterinde hata oluştu!" mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-17" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO092" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/092" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages><mc:messages mc:msgno="094" mc:msgtext="&amp; üretim evresinde &amp; süresinde &amp; gün ihtiyacı %&amp; kapasite planlandı." mc:selfexplainatory="true" mc:documented="false" mc:lastchangedby="MKESKIN" mc:lastmodified="2026-07-21" adtcore:name=""><atom:link href="/sap/bc/adt/vit/docu/object_type/NA/object_name/ZPPAUTO094" rel="http://www.sap.com/adt/relations/longtext" xmlns:atom="http://www.w3.org/2005/Atom"/><atom:link href="/sap/bc/adt/messageclass/zppauto/messages/094" rel="http://www.sap.com/adt/relations/messageclasses/messages" xmlns:atom="http://www.w3.org/2005/Atom"/></mc:messages></mc:messageClass>