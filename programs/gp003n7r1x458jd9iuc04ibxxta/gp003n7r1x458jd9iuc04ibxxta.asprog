FORM FIX USING I_CHANMID TYPE RSSID                                                                                                        "400
               I_FIXSID  TYPE RSSID.                                                                                                       "400
  CASE I_CHANMID.                                                                                                                          "400
    WHEN 3049. G_3049_FIX = I_FIXSID.                                                                                                      "360
    WHEN 3052. G_3052_FIX = I_FIXSID.                                                                                                      "360
    WHEN 3062. G_3062_FIX = I_FIXSID.                                                                                                      "360
  ENDCASE.                                                                                                                                 "400
ENDFORM.                                                                                                                                   "400
