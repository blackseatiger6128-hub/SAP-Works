*--------------------------------------------------------------*
FORM GET_PART USING    I_SX_SPLITPACK  TYPE RSDR0_SX_SPLITPACK "#EC CALLED
                       I_TH_CHARET     TYPE RSDR0_TH_CHARET
                       I_R_MOVE_TYPE   TYPE REF TO CL_ABAP_STRUCTDESCR
                       I_TH_SFC        TYPE RSDD_TH_SFC
                       I_TH_SFK        TYPE RSDD_TH_SFK
                       I_S_DATA        TYPE ANY
                       I_CHECK0        TYPE RS_BOOL
                       I_XFEMS         TYPE XSTRING
                       I_TS_CHXFEMS    TYPE RSDD_TS_CHXFEMS
                       I_S_MINMAX      TYPE RSDD_S_MINMAX
                       I_XWGR          TYPE XSTRING
                       I_XWGR_ALL      TYPE XSTRING
                       I_XWGR_CUID     TYPE XSTRING
                       I_ONLYKEYS      TYPE RRONLYKEYS
                       I_1CUDIM_ACTIVE TYPE RS_BOOL
                       I_TS_CM_BUF     TYPE RRKG_TS_CURMEM_BUFFER.

  DATA: L_S_CHARET    TYPE RSDR0_S_CHARET,
        L_S_CHXFEMS   TYPE RSDD_S_CHXFEMS,
        L_R_KENNZ     TYPE REF TO CL_ABAP_STRUCTDESCR,
        L_R_SX_S_DATA TYPE REF TO DATA,
        L_R_S_DATA    TYPE REF TO DATA.
  DATA: L_XFEMS       TYPE G_XFEMS.                                                                                                        "595

  FIELD-SYMBOLS: <L_S_DATA_WIDE> TYPE DATA.

  CLEAR: G_S_C0, G_KIDSEL.                                                                                                                 "335
  G_CHECK0   = I_CHECK0.
  IF I_SX_SPLITPACK-TS_PARTPROV IS INITIAL.
    G_PARTPROV = I_SX_SPLITPACK-PARTPROV.
    G_PSID     = I_SX_SPLITPACK-PARTPROV_SID.
    G_MULTIPROV = RS_C_FALSE.
  ELSE.
    CLEAR: G_PARTPROV, G_PSID.
    G_MULTIPROV = RS_C_TRUE.
  ENDIF.
  G_INTF     = I_SX_SPLITPACK-INTFORMAT.
  G_NCUM     = I_SX_SPLITPACK-NCUM_VALUES.
  PERFORM GET_KENNZ_TYPE(SAPSRRK0) USING    G_S_KENNZ
                                            I_TH_SFK
                                   CHANGING L_R_KENNZ.
  G_S_KENNZ = G_S_KENNZ_C.
  ASSIGN G_S_KENNZ TO <G_S_KENNZ> CASTING TYPE HANDLE L_R_KENNZ.
  UNASSIGN <G_S_DATA_S____3049>.                                                                                                           "660
  UNASSIGN <G_S_DATA_S____3052>.                                                                                                           "660
  UNASSIGN <G_S_DATA_S____3062>.                                                                                                           "660
  UNASSIGN <G_S_DATA_K____3049>.                                                                                                           "660
  UNASSIGN <G_S_DATA_K____3052>.                                                                                                           "660
  UNASSIGN <G_S_DATA_K____3062>.                                                                                                           "660
  L_R_S_DATA = G_R_CALLBACK->GET_REF_TO_S_DATA( ).
  ASSIGN L_R_S_DATA->* TO <L_S_DATA_WIDE>.
  ASSIGN I_S_DATA TO <G_S_DATA>.
  IF I_SX_SPLITPACK-NCUM_VALUES IS NOT INITIAL.
    ASSIGN <G_S_DATA> TO <L_S_DATA_WIDE>.
  ENDIF.
  ASSIGN COMPONENT 'Z____3057_MAX' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_MM_Z____3057_MAX>. "100                                            "110
  IF SY-SUBRC GT 0. ASSIGN G_C_MM_Z____3057_MAX TO <G_S_DATA_MM_Z____3057_MAX>. ENDIF.                                                     "110
  CREATE DATA L_R_SX_S_DATA LIKE LINE OF <G_TX_S>.
  ASSIGN L_R_SX_S_DATA->* TO <G_SX_S_DATA>.
  ASSIGN COMPONENT 1 OF STRUCTURE <G_SX_S_DATA> TO <G_S_K> CASTING TYPE HANDLE I_R_MOVE_TYPE.
  IF G_CHECK0 EQ RS_C_TRUE.
    ASSIGN COMPONENT 'S____3049' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_S____3049>.                                                          "665
    ASSIGN COMPONENT 'K____3049' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_K____3049>.                                                          "665
    ASSIGN COMPONENT 'S____3052' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_S____3052>.                                                          "665
    ASSIGN COMPONENT 'K____3052' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_K____3052>.                                                          "665
    ASSIGN COMPONENT 'S____3062' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_S____3062>.                                                          "665
    ASSIGN COMPONENT 'K____3062' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_K____3062>.                                                          "665
  ENDIF.
  ASSIGN COMPONENT RRKG_C_SPECIAL_FIELDS-FEMS OF STRUCTURE <G_S_DATA> TO <G_S_DATA_FEMS>.
  ASSIGN COMPONENT 'S____3063' OF STRUCTURE <G_S_DATA> TO <G_S_DATA_S____3063>. "583                                                       "675
  IF SY-SUBRC GT 0. ASSIGN COMPONENT 'S____3063' OF STRUCTURE <L_S_DATA_WIDE> TO <G_S_DATA_S____3063>. ENDIF. "582                         "675
  IF G_SIDFL_3049 EQ 'X' AND <G_S_DATA_S____3049> IS ASSIGNED. ASSIGN <G_S_DATA_S____3049> TO <G_3049>. ENDIF.                             "660
  IF G_SIDFL_3052 EQ 'X' AND <G_S_DATA_S____3052> IS ASSIGNED. ASSIGN <G_S_DATA_S____3052> TO <G_3052>. ENDIF.                             "660
  IF G_SIDFL_3062 EQ 'X' AND <G_S_DATA_S____3062> IS ASSIGNED. ASSIGN <G_S_DATA_S____3062> TO <G_3062>. ENDIF.                             "660
  IF G_SIDFL_3049 EQ ' ' AND <G_S_DATA_K____3049> IS ASSIGNED. ASSIGN <G_S_DATA_K____3049> TO <G_3049>. ENDIF.                             "660
  IF G_SIDFL_3052 EQ ' ' AND <G_S_DATA_K____3052> IS ASSIGNED. ASSIGN <G_S_DATA_K____3052> TO <G_3052>. ENDIF.                             "660
  IF G_SIDFL_3062 EQ ' ' AND <G_S_DATA_K____3062> IS ASSIGNED. ASSIGN <G_S_DATA_K____3062> TO <G_3062>. ENDIF.                             "660

  IF I_TS_CHXFEMS IS NOT INITIAL.
  ENDIF.
  G_SEL_FEMS  = I_SX_SPLITPACK-SEL_FEMS.                                                                                                   "595
  CLEAR: G_CHECK_BIA, G_CHECK_BIA_N.                                                                                                       "595
  IF I_SX_SPLITPACK-FEMS_FILLED NA ' X'. G_CHECK_BIA_N = RS_C_TRUE. ENDIF.                                                                 "595
  IF I_XFEMS IS NOT INITIAL.                                                                                                               "595
    G_SEL_FEMS = G_SEL_FEMS BIT-AND I_XFEMS.                                                                                               "595
    L_XFEMS = G_SEL_FEMS BIT-AND G_C_XFEMS_000A000.                                                                                        "595
    IF G_SEL_FEMS NE L_XFEMS. G_KIDSEL = RS_C_TRUE. ENDIF.                                                                                 "595
  ENDIF.                                                                                                                                   "595
  IF G_KIDSEL EQ RS_C_TRUE OR G_CHECK_BIA_N EQ RS_C_TRUE. G_CHECK_BIA = RS_C_TRUE. ENDIF.                                                  "595
  G_XWGR_MASK = I_XWGR.
  G_XWGR_MASK_ALL = I_XWGR_ALL.
  G_XWGR_MASK_CUID = I_XWGR_CUID.
  G_ONLYKEYS  = I_ONLYKEYS.
  IF <G_CHECK0> EQ RS_C_TRUE.                                                                                                              "335
    LOOP AT I_TH_CHARET INTO L_S_CHARET                                                                                                    "335
         WHERE CHECKFL_0 IS INITIAL.                                                                                                       "335
      CASE L_S_CHARET-CHANM.                                                                                                               "335
        WHEN '2CFY4U8LZA2D9EE4H0YUSAJS44C'. G_S_C0-B3049 = RS_C_TRUE.                                                                      "340
        WHEN '2CGKL288JU3S7YOXFG8T1LFX0PR'. G_S_C0-B3052 = RS_C_TRUE.                                                                      "340
        WHEN '2CNY2S1U7QSJRIFUY1ZHMI9330A'. G_S_C0-B3062 = RS_C_TRUE.                                                                      "340
      ENDCASE.                                                                                                                             "335
    ENDLOOP.                                                                                                                               "335
  ENDIF.                                                                                                                                   "335


  PERFORM INIT_PACKAGE.
ENDFORM.
*---------------------------------------------------------------*
FORM COLLECT_S USING    I_TS_WGR TYPE RRKG_TS_WGR_COLLECT
                        I_ALWAYS_AGGR_TLENG TYPE RS_BOOL
               CHANGING C_SX_CONTENT_I TYPE G_SX_CONTENT
                        C_SX_CONTENT_C TYPE G_SX_CONTENT
  .
  STATICS: L_S_WGR LIKE LINE OF I_TS_WGR.

  LOOP AT I_TS_WGR INTO L_S_WGR.
    CASE L_S_WGR-WGR.
      WHEN 002. "... BEIDES                                                                                                                "710
  STATICS: S_S_D002  TYPE G_S_D002.                                                                                                        "710
    IF C_SX_CONTENT_I-D002-S-INI GT 0.                                                                                                     "710
      IF C_SX_CONTENT_C-D002-S-INI IS INITIAL.                                                                                             "710
        C_SX_CONTENT_C-D002 = C_SX_CONTENT_I-D002.                                                                                         "710
      ELSE.                                                                                                                                "710
        CASE C_SX_CONTENT_C-D002-S-CUDIM.                                                                                                  "710
          WHEN G_C_SID-CU_MIXED_TAB.                                                                                                       "710
            IF C_SX_CONTENT_I-D002-S-CUDIM EQ G_C_SID-CU_MIXED_TAB.                                                                        "710
              LOOP AT C_SX_CONTENT_I-D002-T INTO S_S_D002.                                                                                 "710
                COLLECT S_S_D002 INTO C_SX_CONTENT_C-D002-T.                                                                               "710
              ENDLOOP.                                                                                                                     "710
            ELSE.                                                                                                                          "710
              COLLECT C_SX_CONTENT_I-D002-S INTO C_SX_CONTENT_C-D002-T.                                                                    "710
            ENDIF.                                                                                                                         "710
          WHEN C_SX_CONTENT_I-D002-S-CUDIM.                                                                                                "710
            AGGRGEN_SUM_002 C_SX_CONTENT_I-D002-S C_SX_CONTENT_C-D002-S.                                                                   "710
          WHEN OTHERS.                                                                                                                     "710
            IF C_SX_CONTENT_I-D002-S-CUDIM EQ G_C_SID-CU_MIXED_TAB.                                                                        "710
              S_S_D002 = C_SX_CONTENT_C-D002-S.                                                                                            "710
              C_SX_CONTENT_C-D002 = C_SX_CONTENT_I-D002.                                                                                   "710
              COLLECT S_S_D002 INTO C_SX_CONTENT_C-D002-T.                                                                                 "710
            ELSE.                                                                                                                          "710
              APPEND C_SX_CONTENT_C-D002-S TO C_SX_CONTENT_C-D002-T.                                                                       "710
              APPEND C_SX_CONTENT_I-D002-S TO C_SX_CONTENT_C-D002-T.                                                                       "710
            ENDIF.                                                                                                                         "710
            C_SX_CONTENT_C-D002-S-CUDIM = G_C_SID-CU_MIXED_TAB.                                                                            "710
        ENDCASE.                                                                                                                           "710
      ENDIF.                                                                                                                               "710
    ENDIF.                                                                                                                                 "710
      WHEN 001. "... NUR STRUC                                                                                                             "715
    IF C_SX_CONTENT_I-D001-S-INI GT 0.                                                                                                     "715
      IF C_SX_CONTENT_C-D001-S-INI IS INITIAL.                                                                                             "715
        C_SX_CONTENT_C-D001-S = C_SX_CONTENT_I-D001-S.                                                                                     "715
      ELSE.                                                                                                                                "715
        CL_RSR_RRK0_AGGRGEN_STATIC=>A_MAX_S_RSROA_DF( EXPORTING I_WANZ = 001 I_S_D = C_SX_CONTENT_I-D001-S                                 "715
                                             CHANGING  C_S_D = C_SX_CONTENT_C-D001-S ).                                                    "715
      ENDIF.                                                                                                                               "715
    ENDIF.                                                                                                                                 "715

      WHEN OTHERS.
        G_R_CALLBACK->X_MESSAGE( 'COLLECT_S-WGR-' ).
    ENDCASE.
  ENDLOOP.



ENDFORM.

FORM COLLECT_S_BLFV_FLAGS USING    I_SX_CONTENT TYPE G_SX_CONTENT
                          CHANGING C_SX_CONTENT TYPE G_SX_CONTENT.
ENDFORM.
*--------------------------------------------------------------*
FORM FACTOR_ASSIGN USING I_S_F TYPE G_S_F.

  STATICS: S_OK TYPE RS_BOOL.
     CHECK S_OK EQ RS_C_FALSE.
  ASSIGN I_S_F-F139 TO <G_FI139>.                                                                                                          "290
  S_OK = RS_C_TRUE.
ENDFORM.
