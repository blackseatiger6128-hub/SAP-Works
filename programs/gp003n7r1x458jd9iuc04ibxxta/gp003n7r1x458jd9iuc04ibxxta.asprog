FORM DEBUG_XFEMS.
  PERFORM DEBUG_XFEMS_01 USING 'G_SEL_FEMS'           G_SEL_FEMS.
  PERFORM DEBUG_XFEMS_01 USING 'G_C_XFEMS_000A000' G_C_XFEMS_000A000.                                                                      "815
  BREAK-POINT. G_TX_XFEMS = G_TX_XFEMS.        "#EC *
ENDFORM.
FORM DEBUG_XWGR.
  PERFORM DEBUG_XFEMS_01 USING 'G_XWGR' G_XWGR.
ENDFORM.
