*... NUR STRUCTUR                                                                                                                          "175
DEFINE SET_D001.                                                                                                                           "175
  IF <G_SX_CONTENT>-D001-S-INI IS INITIAL.                                                                                                 "175
    <G_SX_CONTENT>-D001-S = G_S_D000_001.                                                                                                  "175
  ELSE.                                                                                                                                    "175
    CL_RSR_RRK0_AGGRGEN_STATIC=>A_MAX_S_RSROA_DF( EXPORTING I_WANZ = 001 I_S_D = G_S_D000_001                                              "175
                                         CHANGING  C_S_D  = <G_SX_CONTENT>-D001-S ).                                                       "175
  ENDIF.                                                                                                                                   "175
  G_S_D000_001 = G_S_D001_C.                                                                                                               "175
END-OF-DEFINITION.                                                                                                                         "175
*... BEIDES                                                                                                                                "170
DEFINE SET_D002.                                           "150                                                                            "170
  G_S_D139_002-CUDIM  = G_S_QCF-C-C139.                                                                                                    "170
  IF <G_SX_CONTENT>-D002-S-INI IS INITIAL.                                                                                                 "170
    <G_SX_CONTENT>-D002-S = G_S_D139_002.                                                                                                  "170
  ELSE.                                                                                                                                    "170
    CASE <G_SX_CONTENT>-D002-S-CUDIM.                                                                                                      "170
      WHEN G_S_D139_002-CUDIM.                                                                                                             "170
        AGGRGEN_SUM_002 G_S_D139_002 <G_SX_CONTENT>-D002-S.                                                                                "170
      WHEN G_C_SID-CU_MIXED_TAB.                                                                                                           "170
        COLLECT G_S_D139_002 INTO <G_SX_CONTENT>-D002-T.                                                                                   "170
      WHEN OTHERS.                                                                                                                         "170
        APPEND <G_SX_CONTENT>-D002-S TO <G_SX_CONTENT>-D002-T.                                                                             "170
        <G_SX_CONTENT>-D002-S-CUDIM = G_C_SID-CU_MIXED_TAB.                                                                                "170
        APPEND G_S_D139_002 TO <G_SX_CONTENT>-D002-T.                                                                                      "170
    ENDCASE.                                                                                                                               "170
  ENDIF.                                                                                                                                   "170
  G_S_D139_002 = G_S_D002_C.                                                                                                               "170
END-OF-DEFINITION.                                                                                                                         "170

*--------------------------------------------------------------*
DEFINE CHECK_DATA.                                                                                                                         "940
  STATICS: P_FEMS TYPE I, P_XFEMS TYPE G_XFEMS.                                                                                            "595
  DATA: L_OFFS TYPE I.                                                                                                                     "595
  IF <G_S_DATA_FEMS> IS INITIAL.                                                                                                           "595
    P_XFEMS = G_SEL_FEMS.                                                                                                                  "595
    CLEAR L_OFFS.                                                                                                                          "595
    PERFORM MOVE_Z_SP_0001.                                                                                                                "605
  ELSE.                                                                                                                                    "595
    IF     <G_S_DATA_FEMS> LT 10000.                                                 PERFORM CHECK_FEMS USING <G_S_DATA_FEMS>.             "595
    ELSEIF <G_S_DATA_FEMS> LT 1000000000.                                                                                                  "595
      P_FEMS = <G_S_DATA_FEMS> MOD 10000.                                            PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> DIV 10000.                                            PERFORM CHECK_FEMS USING P_FEMS.                      "595
    ELSEIF <G_S_DATA_FEMS> LT 2000000000.                                                                                                  "595
      P_FEMS = <G_S_DATA_FEMS> MOD 1000. <G_S_DATA_FEMS> = <G_S_DATA_FEMS> DIV 1000. PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> MOD 1000. <G_S_DATA_FEMS> = <G_S_DATA_FEMS> DIV 1000. PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> MOD 1000.                                             PERFORM CHECK_FEMS USING P_FEMS.                      "595
    ELSE.                                                                                                                                  "595
      P_FEMS = <G_S_DATA_FEMS> MOD 100.  <G_S_DATA_FEMS> = <G_S_DATA_FEMS> DIV 100.  PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> MOD 100.  <G_S_DATA_FEMS> = <G_S_DATA_FEMS> DIV 100.  PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> MOD 100.  <G_S_DATA_FEMS> = <G_S_DATA_FEMS> DIV 100.  PERFORM CHECK_FEMS USING P_FEMS.                      "595
      P_FEMS = <G_S_DATA_FEMS> MOD 100.                                              PERFORM CHECK_FEMS USING P_FEMS.                      "595
    ENDIF.                                                                                                                                 "595
  ENDIF.                                                                                                                                   "595
END-OF-DEFINITION.                                                                                                                         "940
*--------------------------------------------------------------*
DEFINE SELECT_4.                                                                                                                           "940

  CLEAR G_XWGR.                                                                                                                            "540
  CHECK_DATA.                                                                                                                              "540
  G_XWGR = G_XWGR BIT-AND G_XWGR_MASK_ALL.                                                                                                 "540
  CHECK G_XWGR IS NOT INITIAL OR G_ONLYKEYS = RS_C_TRUE.                                                                                   "540
  G_XWGR = G_XWGR BIT-AND G_XWGR_MASK.                                                                                                     "540
  G_R_QCUBE_DATA_PCK_GEN->SET_COMMIT( RRKG_C_SPCOMMIT-FILLED ).
  IF G_S_QCF-CMESS EQ RRKG_C_CMESS-ERROR.
    PERFORM CU_MESS_SEND.
  ENDIF.
  READ TABLE <G_TX_S> FROM <G_SX_S_DATA> USING KEY (RRKG_C_SP_SEC_KEY) ASSIGNING <G_SX_S>.
  IF SY-SUBRC GT 0.
    INSERT <G_SX_S_DATA> INTO TABLE <G_TX_S> ASSIGNING <G_SX_S>.
  ENDIF.
  ASSIGN COMPONENT 2 OF STRUCTURE <G_SX_S> TO <G_SX_CONTENT>.
  IF G_XWGR+0(1) Z RRKG_C_BX-X14. ELSE.                                                                                                    "530
IF G_XWGR+0(1) O RRKG_C_BX-X1.   SET_D001.  ENDIF.                                                                                         "530
IF G_XWGR+0(1) O RRKG_C_BX-X2.   SET_D002.  ENDIF.                                                                                         "530
  ENDIF.                                                                                                                                   "530

END-OF-DEFINITION.                                                                                                                         "940
*--------------------------------------------------------------*
FORM SELECT_2.

  CLEAR: <G_SX_S_DATA>, G_S_Q.
  MOVE-CORRESPONDING <G_S_DATA> TO <G_S_K>.
  MOVE-CORRESPONDING <G_S_DATA> TO <G_S_KENNZ>.
  IF <G_S_DATA_MM_Z____3057_MAX> EQ G_C_MM_Z____3057_MAX                                                                                   "110
  .                                                                                                                                        "110
    G_S_KENNZ-Z____3057_MAX__W_ = RRKG_C_EPSILON.                                                                                          "110
  ENDIF.                                                                                                                                   "110
  G_S_Q-S3063 = <G_S_DATA_S____3063>.                                                                                                      "515
  G_S_Q-INTF = G_INTF.                                                                                                                     "525
  IF G_S_Q NE G_S_QCF-Q.
    PERFORM GET_FACTOR.
  ENDIF.
  SELECT_4.                                                                                                                                "935
ENDFORM.
