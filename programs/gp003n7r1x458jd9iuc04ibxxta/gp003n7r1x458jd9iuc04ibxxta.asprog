DEFINE SELECT_1.                                                                                                                           "940
  IF <G_CHECK0> EQ RS_C_FALSE.                                                                                                             "335
    PERFORM SELECT_2.                                                                                                                      "335
  ELSE.                                                                                                                                    "335
    PERFORM SELECT_1_CHECK0.                                                                                                               "335
  ENDIF.                                                                                                                                   "335
END-OF-DEFINITION.                                                                                                                         "940
*--------------------------------------------------------------*
FORM SELECT_0 CHANGING C_T_DATA TYPE STANDARD TABLE.
  LOOP AT C_T_DATA INTO <G_S_DATA>.
    SELECT_1.                                                                                                                              "935
  ENDLOOP.
  G_R_CALLBACK->COMPRESS_TX_S( EXPORTING I_XWGR_MASK = G_XWGR_MASK CHANGING C_TX_S = <G_TX_S> ).
ENDFORM.
*--------------------------------------------------------------*                                                                           "585
FORM MOVE_Z_SP_0001                                           "1                                                                           "585
  .                                                              "1                                                                        "585
        G_S_D000_001-W001 =  G_S_KENNZ-Z____3057_MAX__W_ .                          "6                                                     "585
        G_XWGR+0(1) = G_XWGR+0(1) BIT-OR RRKG_C_BX-X1.   "8                                                                                "585
        G_S_D139_002-W001 =  G_S_KENNZ-Z____3059_SUM__W_ * <G_FI139> .                          "6                                         "585
        G_XWGR+0(1) = G_XWGR+0(1) BIT-OR RRKG_C_BX-X2.   "8                                                                                "585
        G_S_D139_002-W002 =  G_S_KENNZ-Z____3064_SUM__W_ * <G_FI139> .                          "6                                         "585
        G_XWGR+0(1) = G_XWGR+0(1) BIT-OR RRKG_C_BX-X2.   "8                                                                                "585
  ENDFORM.                                                       "I                                                                        "585
*--------------------------------------------------------------*                                                                           "595
FORM CHECK_FEMS USING I_FEMS TYPE I.
  STATICS: P_BIT TYPE I.                                                                                                                   "595
    IF G_CHECK_BIA EQ RS_C_TRUE.                                                                                                           "595
    IF G_KIDSEL EQ RS_C_TRUE. GET BIT I_FEMS OF G_SEL_FEMS INTO P_BIT. CHECK P_BIT = 1. ENDIF.                                             "595
    IF G_CHECK_BIA_N EQ RS_C_TRUE.                                                                                                         "595
    ENDIF. ENDIF.                                                                                                                          "595
  PERFORM I_FEMS OF           " REP I_FEMS = 2                                                                                             "615
          MOVE_Z_SP_0001                                                                                                                   "620
          DEBUG_XFEMS.                                                                                                                     "615
ENDFORM.                      " NOW LOOK AT G_TSX_XFEMS
*--------------------------------------------------------------*
FORM SET_XFEMSBIT.
  FIELD-SYMBOLS: <L_X> TYPE X.                                                                                                             "640
  ASSIGN  G_C_XFEMS_000A000+000(01) TO <L_X>. <L_X> = '80' .                                                                               "640
ENDFORM.

