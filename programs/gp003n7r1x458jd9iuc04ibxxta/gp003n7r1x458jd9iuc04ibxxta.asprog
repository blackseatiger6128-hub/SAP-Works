FORM SELECT_1_CHECK0.                                                                                                                      "335
  IF G_S_C0 IS INITIAL.                                                                                                                    "335
IF <G_3049> EQ <G_C_3049_001>  .                                                                                                           "495
IF <G_3052> EQ <G_C_3052_002>  .                                                                                                           "495
IF <G_3062> EQ <G_C_3062_003>  .                                                                                                           "495
    PERFORM SELECT_2.                                                                                                                      "495
ENDIF.                                                                                                                                     "495
ENDIF.                                                                                                                                     "495
ENDIF.                                                                                                                                     "495
  ELSE.                                                                                                                                    "335
IF G_S_C0-B3049 EQ RS_C_TRUE OR <G_3049> EQ <G_C_3049_001>  .                                                                              "500
IF G_S_C0-B3052 EQ RS_C_TRUE OR <G_3052> EQ <G_C_3052_002>  .                                                                              "500
IF G_S_C0-B3062 EQ RS_C_TRUE OR <G_3062> EQ <G_C_3062_003>  .                                                                              "500
    PERFORM SELECT_2.                                                                                                                      "500
ENDIF.                                                                                                                                     "500
ENDIF.                                                                                                                                     "500
ENDIF.                                                                                                                                     "500
  ENDIF.                                                                                                                                   "335
ENDFORM.                                                                                                                                   "335
