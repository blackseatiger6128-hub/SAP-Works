*&---------------------------------------------------------------------*
*& Report zmk_test_09
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zmk_test_09.

DATA: lv_carrid TYPE s_carrid,
      lv_where TYPE string.

SELECT-OPTIONS: s_carrid FOR lv_carrid.

START-OF-SELECTION.
  lv_where = cl_shdb_seltab=>combine_seltabs(
                EXPORTING
                   it_named_seltabs = VALUE #( ( name = 'CARRID' dref = REF #( s_carrid[] ) ) )
                    iv_client_field = 'MANDT' ).

zcl_zmk_amdp_ex02=>amdp_procedure(
           EXPORTING
             iv_sel_opt_carrid = lv_where
           IMPORTING
              et_scarr = data(lt_scarr)
            ).

cl_salv_table=>factory(
 exporting
    list_display = if_salv_c_bool_sap=>false
*  r_container  type ref to cl_gui_container optional
*  container_name  type string optional
  importing
    r_salv_table = data(lo_alv)
   changing t_table = lt_scarr
" raising cx_salv_msg
     ).

lo_alv->display( ).