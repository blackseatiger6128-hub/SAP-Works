REPORT zmk_abap_cds_consume1.

 """ CDS - Joins

*  SELECT *
*    FROM zmk_sd_all_joins
*    INTO TABLE @DATA(lt_data).
*  IF lt_data IS NOT INITIAL.
*    cl_demo_output=>display( lt_data ).
*  ENDIF.

  """ CDS - Association

*  SELECT ebeln, bstyp, lifnr, \_vend-land1, \_vend-name1, \_poi-ebelp, \_poi-matnr,
*    \_poi\_mat-mtart, \_poi\_mat-mbrsh, \_poi\_mat\_desc-maktx
*
*    FROM ZMK_MM_ASSOC2
*    INTO TABLE @DATA(lt_data).
*  IF lt_data IS NOT INITIAL.
*    cl_demo_output=>display( lt_data ).
*  ENDIF.

""" CDS - ALV IDA
  TRY .
      cl_salv_gui_table_ida=>create_for_cds_view(
        EXPORTING
          iv_cds_view_name      = 'ZMK_SD_ALL_JOINS'
*      io_gui_container      =
*      io_calc_field_handler =
        RECEIVING
          ro_alv_gui_table_ida  = DATA(lo_alv)
      ).
    CATCH cx_salv_db_connection.          " Error connecting to database
    CATCH cx_salv_db_table_not_supported. " DB table / view is not supported
    CATCH cx_salv_ida_contract_violation. " IDA API contract violated by caller
    CATCH cx_salv_function_not_supported. " Funcionality is not supported
  ENDTRY.

  IF lo_alv IS BOUND.
    TRY.
        lo_alv->fullscreen(
          RECEIVING
            ro_fullscreen = DATA(lo_full)
        ).
      CATCH cx_salv_ida_contract_violation. " IDA API contract violated by caller
    ENDTRY.
  ENDIF.

  IF lo_full IS BOUND.
    lo_full->display( ).
  ENDIF.