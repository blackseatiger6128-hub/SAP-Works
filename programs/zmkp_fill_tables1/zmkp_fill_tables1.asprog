*&---------------------------------------------------------------------*
*& Report zmkp_fill_tables1
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zmkp_fill_tables1.

DATA itab TYPE TABLE OF zmk_prd_price.

itab = VALUE #( ( bptype = 'DIST_PERC' bpperc = 70 )
                ( bptype = 'DELR_PERC' bpperc = 80 ) ).

* delete existing entries in the database table
DELETE FROM zmk_prd_price.
IF sy-subrc = 0.
ENDIF.
* insert the new table entries
INSERT zmk_prd_price FROM TABLE @itab.
IF sy-subrc = 0.
ENDIF.

