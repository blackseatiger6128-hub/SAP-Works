FUNCTION enqueue_ez_zppauto_prod
  IMPORTING
    VALUE(mode_zppauto_prod) TYPE enqmode DEFAULT 'E'
    VALUE(client) TYPE zppauto_prod-client DEFAULT sy-mandt
    VALUE(plan_uuid) TYPE zppauto_prod-plan_uuid OPTIONAL
    VALUE(x_plan_uuid) TYPE any DEFAULT space ##ADT_PARAMETER_UNTYPED
    VALUE(_scope) TYPE any DEFAULT '2' ##ADT_PARAMETER_UNTYPED
    VALUE(_wait) TYPE any DEFAULT space ##ADT_PARAMETER_UNTYPED
    VALUE(_collect) TYPE ddenqcoll DEFAULT ' '
  EXCEPTIONS
    foreign_lock
