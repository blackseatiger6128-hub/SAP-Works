@Metadata.layer: #CORE
@UI.headerInfo: { title: { value: 'Projid' },
                  description: { value: 'ProjectName' } 
                  }
annotate entity ZMKC_PROJECT with
{
  // Project Info
  @UI.facet: [{ position: 10, label: 'Project Info', type: #IDENTIFICATION_REFERENCE },
              { position: 20, label: 'Skill Set', type: #LINEITEM_REFERENCE, targetElement: '_skills' } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @EndUserText: { label: 'Employee ID' }
  Emplid;

  @UI.lineItem: [{ position: 20 }] 
  @UI.identification: [{ position: 20 }]
  @EndUserText: { label: 'Project ID' }
  Projid;

  @UI.lineItem: [{ position: 30 }] 
  @UI.identification: [{ position: 30 }]
  @EndUserText: { label: 'Project Name' }
  ProjectName;

  @UI.lineItem: [{ position: 40, criticality: 'ProjectCriticality' }]
  @UI.identification: [{ position: 40 }] 
  @EndUserText: { label: 'Project type' }
  @UI.textArrangement: #TEXT_ONLY
  ProjectType;

  @UI.lineItem: [{ position: 50 }] 
  @UI.identification: [{ position: 50 }]
  @EndUserText: { label: 'Current Project ?' }
  IsCurrent;

  @UI.lineItem: [{ position: 60 }] 
  @UI.identification: [{ position: 60 }]
  @EndUserText: { label: 'Project Duration' }
  Duration;
  /* Associations */
  //_empl;

}