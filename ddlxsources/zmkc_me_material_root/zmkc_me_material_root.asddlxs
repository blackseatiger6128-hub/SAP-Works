@Metadata.layer: #CORE
@UI: { 
       headerInfo: { 
            typeName: 'Material', 
            typeNamePlural: 'Materials',
             title: { type: #STANDARD, value: 'Material' }, 
             description: { value: 'Description' } 
                   } 
     }
annotate entity ZMKI_MATERIAL_ROOT
    with 
{
    @UI.facet: [ 
       { id: 'Overview', type: #IDENTIFICATION_REFERENCE, label: 'Overview', targetQualifier: 'Identification' },
       { id: 'PlantStock', type: #LINEITEM_REFERENCE, label: 'Plant & Stock', targetElement: '_PlantStock' }, 
       { id: 'SalesOrg', type: #LINEITEM_REFERENCE, label: 'Sales Org Data', targetElement: '_Sales' }, 
       { id: 'Purch', type: #LINEITEM_REFERENCE, label: 'Purchasing/Sourcing', targetElement: '_Purch' } 
    ]
 
    // --- List Report 
    @UI.lineItem: [{ position: 10, importance: #HIGH }] 
    @UI.selectionField: [{ position: 10 }] 
    @UI.identification: [{ position: 10 }] 
    @Consumption.valueHelpDefinition: [ { entity: { name: 'ZMKVH_MaterialF4', element: 'Material' } } ] 
    @UI.textArrangement: #TEXT_FIRST 
    Material;
    
    @UI.lineItem: [{ position: 20, importance: #HIGH }] 
    @UI.identification: [{ position: 20 }] 
    Description; 
    
    @UI.selectionField: [{ position: 20 }]
    @UI.identification: [{ position: 30 }] 
    @UI.lineItem: [{ position: 30 }] 
    @Consumption.valueHelpDefinition: [ { entity: { name: 'ZMKVH_MaterialType', element: 'MaterialType' } } ] 
    @UI.textArrangement: #TEXT_FIRST 
    MaterialType; 
    
    @UI.identification: [{ position: 40 }]
    @UI.lineItem: [{ position: 40 }] 
    BaseUoM; 
    
    @UI.identification: [{ position: 60 }]
    MaterialStatus; 
    
    @UI.identification: [{ position: 70 }] 
    CreatedOn;
    
}